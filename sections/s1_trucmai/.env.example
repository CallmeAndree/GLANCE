# Preferred natural Vietnamese voice
OPENAI_API_KEY=
TTS_PROVIDER=auto
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=1.0

# Optional Azure Speech alternative
AZURE_SUBSCRIPTION_KEY=
AZURE_SERVICE_REGION=
AZURE_TTS_VOICE=vi-VN-HoaiMyNeural
AZURE_TTS_RATE=0%
AZURE_TTS_PITCH=0%

# 480p preview output
S1_RENDER_FPS=15
S1_OUTPUT_W=854
S1_OUTPUT_H=480
FORCE_REGENERATE_AUDIO=0
ALLOW_ESPEAK_FALLBACK=1
