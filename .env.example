# Copy file này thành .env rồi điền token. .env đã nằm trong .gitignore.

# ---------------------------------------------------------------------------
# Backend chính thức của nhóm. Bản nộp phải render bằng backend này để giọng
# đồng nhất giữa các section. Endpoint được self-host nên có lúc tắt.
# ---------------------------------------------------------------------------
GLANCE_TTS=timed
GLANCE_TIMED_TTS_URL=https://acdbentity-concentrate-poison-enters.trycloudflare.com/v1/audio/speech
GLANCE_TIMED_TTS_KEY_FILE=.run/api.key
GLANCE_TIMED_TTS_VOICE=longkhongphainong
GLANCE_TIMED_TTS_FORMAT=mp3

# ---------------------------------------------------------------------------
# Dự phòng, CHỈ dùng khi endpoint trên không chạy và cần render thử.
# Giọng khác hẳn backend chính, đừng dùng cho bản nộp.
#
#   GLANCE_TTS=gtts     miễn phí, cần mạng, không cần khoá gì
#   GLANCE_TTS=record   tự thu giọng thật, cần SoX
#   GLANCE_TTS=azure    cần các khoá dưới đây và extra [azure]
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_KEY=
AZURE_SERVICE_REGION=eastasia
# Nữ: en-US-AvaMultilingualNeural; nam: en-US-AndrewMultilingualNeural.
# Không dùng JennyMultilingual/RyanMultilingual vì không hỗ trợ vi-VN.
GLANCE_VOICE=en-US-AvaMultilingualNeural
